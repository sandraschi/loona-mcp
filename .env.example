# Loona MCP configuration
LOONA_MCP_PORT=11069
LOONA_MCP_HOST=127.0.0.1

# ADB path (Phase 1 software attack)
LOONA_ADB_PATH=C:\platform-tools\adb.exe

# Loona WiFi API (if ADB fails, fallback to reverse-engineered HTTP API)
LOONA_IP=192.168.1.100
LOONA_API_TOKEN=

# Hardware attack tooling paths
SIGROK_CLI=C:\Program Files\sigrok\sigrok-cli\sigrok-cli.exe

# RPi target (Phase 3 gut+replace)
RPI_HOST=raspberrypi.local
RPI_USER=pi

# Ollama for local AI stack
OLLAMA_BASE_URL=http://localhost:11434
